# ===========================================================================
# ClimateSphere AI - example environment file
# Copy to `.env` (backend/) or export as real environment variables.
# Do NOT put real credentials here - this file is committed to the repository.
# ===========================================================================

# ---- backend (backend/.env or real environment variables) ----
MONGO_URI=mongodb://localhost:27017
# MongoDB Atlas example (placeholders only - replace locally, never commit):
# MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_DB=climatesphere
ALLOW_MOCK_DB=1                              # dev only: use in-memory DB if MongoDB is unreachable. Set 0 in production.
CORS_ORIGINS=http://localhost:5173           # comma-separated list of allowed front-end origins
TRUST_PROXY=0                                # set 1 behind Render/Cloud Run/nginx so rate limits use the real client IP
RATE_DEFAULT_PER_MIN=120
RATE_HEAVY_PER_MIN=30
RATE_POST_PER_MIN=10
UPSTREAM_PER_MIN=300                         # global cap on outbound calls to Open-Meteo / World Bank
GEMINI_API_KEY=                              # optional: LLM narration on the AI Lab page (rule-based text if empty)
GEMINI_MODEL=gemini-2.5-flash
CLIMATE_MODELS=EC_Earth3P_HR,MRI_AGCM3_2_S,MPI_ESM1_2_XR   # Open-Meteo Climate API (CMIP6) models

# ---- frontend (frontend/.env.production) ----
# VITE_API_BASE=https://your-api.onrender.com
# Optional map basemap override (default is Esri World Dark Gray Canvas, no key required).
# VITE_TILE_URL=https://services.arcgisonline.com/ArcGIS/rest/services/Canvas/World_Dark_Gray_Base/MapServer/tile/{z}/{y}/{x}
# VITE_TILE_ATTRIBUTION=Tiles &copy; Esri
